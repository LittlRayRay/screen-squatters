{
  "manifest_version": 3,
  "name": "Screen Squatters · Firefox live feed",
  "version": "0.5.0",
  "incognito": "not_allowed",
  "description": "Share the focused page, metadata and captions, plus non-private tab open/close/switch events with your companions.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["background.js"]},
  "browser_specific_settings": {
    "gecko": {
      "id": "screen-squatters@littlrayray.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["websiteContent", "browsingActivity", "websiteActivity"]}
    },
    "gecko_android": {"strict_min_version": "142.0"}
  },
  "action": {"default_popup": "popup.html", "default_title": "Screen Squatters · live browser feed"}
}
