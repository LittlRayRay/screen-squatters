{
  "manifest_version": 3,
  "name": "Screen Squatters · browser companion",
  "version": "0.3.0",
  "description": "Share visible browser text with Pip, Byte and Rex on your desktop.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Share with your housemates"}
}
